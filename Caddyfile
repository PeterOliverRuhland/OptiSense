# Die Adresse kommt aus der Datei .env (Variable SITE_ADDRESS).
# WebSockets muss man bei Caddy nicht konfigurieren - reverse_proxy
# reicht Upgrade-Verbindungen automatisch durch. Genau das braucht Shiny.

{$SITE_ADDRESS} {
	# Anfragen sind klein (Klicks, .lp-Dateien bis 20 KB) - groessere Uploads gar nicht erst annehmen.
	request_body {
		max_size 1MB
	}

	# Vier App-Container (docker-compose.yml). Shiny haelt eine Sitzung (Modell, Lernaufgabe) im Prozess,
	# darum bleibt jeder Browser per Cookie beim selben Container. Neue Besucher gehen an den Container
	# mit den wenigsten offenen Verbindungen (jede offene Seite haelt eine WebSocket-Verbindung).
	reverse_proxy app1:8000 app2:8000 app3:8000 app4:8000 {
		lb_policy cookie optisense_lb {
			fallback least_conn
		}
		# faellt ein Container aus, gehen neue Anfragen 30 s lang an die anderen
		fail_duration 30s
	}

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# nur HTTPS (wirkt erst, wenn die Seite ueber HTTPS laeuft)
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Datenschutz: IP-Adressen nur gekuerzt speichern (IPv4 ohne letzte Stelle)
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
		}
	}
}
